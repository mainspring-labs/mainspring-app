{
  "name": "@mainspring-labs/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Mainspring: read spring, factory and instance state, resolve CAP-85 executable references, and decode upgrade events.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mainspring-labs/mainspring-app",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:spec": "bash scripts/gen-spec.sh"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
